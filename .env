# If set to **anything**, uses mock_minio (filesystem) instead of a hosted minio instance.
# The purpose of FC_USE_MOCK_MINIO is to use the filesystem when running the test suite.
#FC_USE_MOCK_MINIO=1
# Allows verbose console output in certain use cases. Will print verbose output if set to
# **anything**.
FC_VERBOSE=1
# The ndm_unadjusted program can parallelize the work across multiple CPU cores. The program
# will discover how many CPUs are available automatically, but setting FC_CPU_COUNT will
# override the discovered default.
FC_CPU_COUNT=8
# Secret key for the flask application.
FC_FLASK_SECRET_KEY=
 
# Namespace that Argo should use to create/list workflows.
ARGO_NAMESPACE=frontiercounts
# Name of the template from which Argo Workflows are created.
# Entrypoint of the Argo Workflow template.
ARGO_TEMPLATE_ENTRYPOINT=on-workflow-template
# Kubernetes service account that the argo workflow pod(s) should run under.
ARGO_SERVICE_ACCOUNT=argo-workflows
# URL of the documentation site - this is used by the test runner to present
# documentation links where relevant for unit/integration tests.
DOC_BASE_URL=http://docs
# Base URL for the flask web application
FLASK_BASE_URL=http://localhost:5000
# # URL to for the web application to make API calls to Argo Workflows server.
# ARGO_HOST=https://argo-workflows.test.cloud.statcan.ca/
ARGO_HOST=http://argo
